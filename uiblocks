      bars:`<div style="display:flex;gap:${s/8}px;align-items:flex-end;height:${s}px">${[0,.1,.2,.3,.4].map((d,i)=>`<div style="width:${s/6}px;background:${p.accent};animation:barGrow ${sp}s ease-in-out ${d}s infinite alternate;height:${30+i*14}%" aria-hidden="true"></div>`).join('')}</div>`,
