  { id:'c5', text:'Create an <strong>analytics dashboard</strong> and change the primary stat color to emerald green.', hint:'Use Analytics Dashboard and set Primary color to #10b981.' },
  { id:'c6', text:'Stack <strong>3 toast notifications</strong> — one success, one warning, one error.', hint:'Open Toast Notification Stack and switch variants.' },
  { id:'c7', text:'Build a <strong>4-column product card grid</strong> by customising the Product Card.', hint:'Customise the Product Card and explore the variant switcher.' },
  { id:'c8', text:'Create a <strong>centered-logo navbar</strong> with 4 left links and 4 right links.', hint:'Use Centered Logo Nav and update the links field.' },
  { id:'c9', text:'Assemble a <strong>full landing page</strong> — use the Landing Page Shell and swap the accent color.', hint:'Use Page Layouts → Landing Page Shell.' },
  { id:'c10', text:'Build a <strong>vertical timeline</strong> with 5 milestones and a custom accent color.', hint:'Use Vertical Timeline and add 5 comma-separated events.' },
];
</script>

<script>
// ═══════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════
let activeCategory = 'all';
let viewMode = 'grid';
let activeComp = null;
let activeProps = {};
let activeVariantIdx = 0;
let activeCodeTab = 'html';
let savedIds = [];
let challengeActive = false;
let challengeIdx = 0;
let challengeTimer = null;
let challengeSecs = 300;
let filterOnlyNew = false;

// ═══════════════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  initTheme();
  loadSaved();
  buildSidebar();
  renderGrid('all');
  setupKeyboard();
  checkUrlHash();
});

function checkUrlHash() {
  const h = location.hash.replace('#','');
  if (h && COMPS.find(c => c.id === h)) openDetail(h);
}

// ═══════════════════════════════════════════════════════════
// SIDEBAR
// ═══════════════════════════════════════════════════════════
function buildSidebar() {
  const nav = document.getElementById('sidebarNav');
  const total = COMPS.length;
  document.getElementById('sidebarCount').textContent = `${total} components`;

  nav.innerHTML = CATS.map(cat => {
    const count = cat.id === 'all' ? total : COMPS.filter(c => c.cat === cat.id).length;
    if (count === 0 && cat.id !== 'all') return '';
    return `<div class="sidebar-item ${cat.id === 'all' ? 'active' : ''}" 
      onclick="selectCat('${cat.id}',this)" 
      role="listitem button" 
      aria-label="Show ${cat.label} (${count})"
      tabindex="0"
      onkeydown="if(event.key==='Enter')selectCat('${cat.id}',this)">
      <span>${cat.icon} ${cat.label}</span>
      <span class="si-count">${count}</span>
      ${cat.isNew ? '<span class="badge badge-new">New</span>' : ''}
    </div>`;
  }).join('');
}

function selectCat(id, el) {
  activeCategory = id;
  filterOnlyNew = false;
  document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
  el.classList.add('active');
  renderGrid(id);
}

// ═══════════════════════════════════════════════════════════
// GRID RENDER
// ═══════════════════════════════════════════════════════════
function renderGrid(cat) {
  let comps = cat === 'all' ? COMPS : COMPS.filter(c => c.cat === cat);
  if (filterOnlyNew) comps = comps.filter(c => c.isNew);

  const catObj = CATS.find(c => c.id === cat);
  const title = catObj ? catObj.label.toUpperCase() : 'ALL COMPONENTS';
  document.getElementById('toolbarTitle').innerHTML = title.includes(' ')
    ? `${title.split(' ')[0]} <span>${title.split(' ').slice(1).join(' ')}</span>`
    : title;
  document.getElementById('toolbarCount').textContent = `${comps.length} component${comps.length !== 1 ? 's' : ''}`;

  const area = document.getElementById('compArea');
  area.className = `comp-area ${viewMode === 'grid' ? 'comp-grid-view' : 'comp-list-view'}`;

  if (comps.length === 0) {
    area.innerHTML = `<div class="empty-state"><div class="empty-icon">⊟</div><div class="empty-title">Nothing here</div><div class="empty-desc">No components match this filter</div></div>`;
    return;
  }

  area.innerHTML = comps.map(comp => viewMode === 'grid' ? renderCard(comp) : renderListItem(comp)).join('');
  area.querySelectorAll('.cc, .cc-list').forEach(el => el.classList.add('anim-in'));
}

function renderCard(comp) {
  const preview = comp.render(comp.defaultProps);
  const isSaved = savedIds.includes(comp.id);
  return `<div class="cc" style="--cc-color:${comp.defaultProps.accent || '#5558f0'}" role="listitem">
    <div class="cc-top-bar" aria-hidden="true"></div>
    <div class="cc-preview" onclick="openDetail('${comp.id}')" role="button" tabindex="0" aria-label="Open ${comp.name}" onkeydown="if(event.key==='Enter')openDetail('${comp.id}')">
      <div class="cc-preview-grid" aria-hidden="true"></div>
      <div style="transform:scale(.62);transform-origin:center;pointer-events:none;width:100%;display:flex;align-items:center;justify-content:center;overflow:hidden;max-height:140px">${preview}</div>
      <div class="cc-expand-hint" aria-hidden="true">Click to edit →</div>
    </div>
    <div class="cc-meta">
      <div class="cc-name">${comp.name}</div>
      <div class="cc-tags">${(comp.tags || []).slice(0,3).map(t => `<span class="cc-tag">${t}</span>`).join('')}${comp.isNew ? '<span class="badge badge-new">New</span>' : ''}</div>
    </div>
    <div class="cc-actions">
      <button class="cc-btn primary" onclick="openDetail('${comp.id}')" aria-label="Edit ${comp.name}">Edit &amp; Copy</button>
      <button class="cc-btn ${isSaved ? 'saved' : ''}" id="save-${comp.id}" onclick="toggleSaveComp('${comp.id}')" aria-label="${isSaved ? 'Remove from saved' : 'Save'} ${comp.name}">${isSaved ? '★ Saved' : '☆ Save'}</button>
    </div>
  </div>`;
}

function renderListItem(comp) {
  const preview = comp.render(comp.defaultProps);
  return `<div class="cc-list" onclick="openDetail('${comp.id}')" role="listitem button" tabindex="0" aria-label="Open ${comp.name}">
    <div class="cc-list-preview">${preview.substring(0,200)}</div>
    <div style="flex:1">
      <div class="cc-list-name">${comp.name}</div>
      <div class="cc-list-meta">${(comp.tags||[]).map(t=>`<span class="cc-tag">${t}</span>`).join('')}${comp.isNew?'<span class="badge badge-new">New</span>':''}</div>
    </div>
    <div class="cc-list-actions">
      <button class="cc-btn primary" onclick="event.stopPropagation();openDetail('${comp.id}')" aria-label="Edit ${comp.name}">Edit</button>
      <button class="cc-btn" onclick="event.stopPropagation();toggleSaveComp('${comp.id}')" aria-label="Save ${comp.name}">★</button>
    </div>
  </div>`;
}

// ═══════════════════════════════════════════════════════════
// DETAIL VIEW
// ═══════════════════════════════════════════════════════════
function openDetail(id) {
  const comp = COMPS.find(c => c.id === id);
  if (!comp) return;

  activeComp = comp;
  activeProps = { ...comp.defaultProps };
  activeVariantIdx = 0;

  // Title & save state
  document.getElementById('detailTitle').textContent = comp.name;
  updateDetailSaveBtn();

  // Variants
  const sel = document.getElementById('variantSelect');
  sel.innerHTML = (comp.variants || ['Default']).map((v,i) => `<option value="${i}">${v}</option>`).join('');

  // Variant buttons in editor
  document.getElementById('epVariantsBody').innerHTML = (comp.variants || ['Default']).map((v,i) =>
    `<button class="prop-chip ${i===0?'active':''}" onclick="switchVariant(${i},this)">${v}</button>`
  ).join('');

  // Build prop editor
  buildPropEditor(comp);

  // Info panel
  document.getElementById('epInfoBody').innerHTML = `
    <div class="prop-row"><span class="prop-label">Category</span><span style="font-family:var(--mono);font-size:10px;color:var(--text2)">${CATS.find(c=>c.id===comp.cat)?.label || comp.cat}</span></div>
    <div class="prop-row"><span class="prop-label">Tags</span><div class="cc-tags" style="margin-top:4px">${(comp.tags||[]).map(t=>`<span class="cc-tag">${t}</span>`).join('')}</div></div>
    <div class="prop-row"><span class="prop-label">Variants</span><span style="font-family:var(--mono);font-size:10px;color:var(--text2)">${(comp.variants||['Default']).length}</span></div>
  `;

  // Update preview and code
  updatePreview();
  updateCode();

  // Open modal
  document.getElementById('detailBackdrop').classList.add('open');
  document.body.style.overflow = 'hidden';

  // URL hash
  try { history.replaceState(null, comp.name, '#' + comp.id); } catch(e) {}
}

function closeDetail(e) {
  if (e && e.target !== document.getElementById('detailBackdrop')) return;
  document.getElementById('detailBackdrop').classList.remove('open');
  document.body.style.overflow = '';
  try { history.replaceState(null, 'UIBlocks', location.pathname); } catch(e) {}
}

function buildPropEditor(comp) {
  const body = document.getElementById('epPropsBody');
  body.innerHTML = '';

  (comp.propSchema || []).forEach(prop => {
    const val = activeProps[prop.key];
    const row = document.createElement('div');
    row.className = 'prop-row';

    let ctrl = '';
    switch(prop.type) {
      case 'color':
        ctrl = `<div class="prop-color">
          <input type="color" value="${val}" onchange="setProp('${prop.key}',this.value);syncColorText('${prop.key}')" id="pc-${prop.key}" aria-label="${prop.label} color picker">
          <input type="text" value="${val}" onchange="setProp('${prop.key}',this.value);syncColorPicker('${prop.key}')" id="pt-${prop.key}" aria-label="${prop.label} hex value">
        </div>`;
        break;
      case 'range':
        ctrl = `<input type="range" min="${prop.min||0}" max="${prop.max||100}" step="${prop.step||1}" value="${val}" 
          oninput="setProp('${prop.key}',this.value);document.getElementById('pv-${prop.key}').textContent=this.value" 
          aria-label="${prop.label}">`;
        break;
      case 'text':
        ctrl = `<input type="text" class="prop-select" value="${escHtml(String(val))}" 
          oninput="setProp('${prop.key}',this.value)" aria-label="${prop.label}">`;
        break;
      case 'select':
        ctrl = `<select class="prop-select" onchange="setProp('${prop.key}',this.value)" aria-label="${prop.label}">
          ${(prop.options||[]).map(o=>`<option ${o===val?'selected':''}>${o}</option>`).join('')}
        </select>`;
        break;
      case 'chips':
        ctrl = `<div class="prop-chips">${(prop.options||[]).map(o=>`<button class="prop-chip ${o===val?'active':''}" 
          onclick="setProp('${prop.key}','${o}');this.parentElement.querySelectorAll('.prop-chip').forEach(c=>c.classList.remove('active'));this.classList.add('active')"
          aria-pressed="${o===val}">${o}</button>`).join('')}</div>`;
        break;
      case 'toggle':
        ctrl = `<div class="prop-toggle-row">
          <span style="font-family:var(--mono);font-size:10px;color:var(--text3)">${prop.label}</span>
          <button class="prop-toggle ${val?'on':''}" id="tog-${prop.key}" 
            onclick="setProp('${prop.key}',!${val});this.classList.toggle('on')"
            role="switch" aria-checked="${val}" aria-label="Toggle ${prop.label}"></button>
        </div>`;
        break;
    }

    if (prop.type !== 'toggle') {
      row.innerHTML = `<div class="prop-label">${prop.label} ${prop.type==='range'?`<span id="pv-${prop.key}" class="prop-val">${val}</span>`:''}</div>${ctrl}`;
    } else {
      row.innerHTML = ctrl;
    }
    body.appendChild(row);
  });

  // Reset button
  const reset = document.createElement('button');
  reset.className = 'ep-reset-btn';
  reset.textContent = '↺ Reset to defaults';
  reset.setAttribute('aria-label', 'Reset all props to default values');
  reset.onclick = () => { activeProps = {...activeComp.defaultProps}; buildPropEditor(activeComp); updatePreview(); updateCode(); };
  body.appendChild(reset);
}

function setProp(key, val) {
  activeProps[key] = val;
  updatePreview();
  updateCode();
}

function syncColorText(key) {
  const input = document.getElementById('pt-'+key);
  if (input) input.value = document.getElementById('pc-'+key).value;
}

function syncColorPicker(key) {
  const v = document.getElementById('pt-'+key)?.value;
  if (v && /^#[0-9a-f]{6}$/i.test(v)) {
    const cp = document.getElementById('pc-'+key);
    if (cp) cp.value = v;
  }
}

function updatePreview() {
  if (!activeComp) return;
  try {
    const html = activeComp.render(activeProps);
    document.getElementById('dpPreviewInner').innerHTML = html;
  } catch(e) {
    document.getElementById('dpPreviewInner').innerHTML = `<div style="font-family:var(--mono);font-size:10px;color:var(--red)">Preview error: ${escHtml(e.message)}</div>`;
  }
}

function updateCode() {
  if (!activeComp) return;
  const c = activeComp.code || {};
  const htmlStr = c.html || '';
  const cssStr = c.css || '';
  const twStr = c.tailwind || '';
  const reactStr = c.react || '';

  document.getElementById('codeHtml').textContent = htmlStr;
  document.getElementById('codeCss').textContent = cssStr;
  document.getElementById('codeTailwind').textContent = twStr;
  document.getElementById('codeReact').textContent = reactStr;

  const active = activeCodeTab;
  const lines = { html: htmlStr, css: cssStr, tailwind: twStr, react: reactStr }[active] || '';
  document.getElementById('codeMeta').textContent = `${active.toUpperCase()} · ${lines.split('\n').length} lines`;
}

function switchCodeTab(tab, btn) {
  activeCodeTab = tab;
  document.querySelectorAll('.code-tab').forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected','false'); });
  document.querySelectorAll('.code-pane').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  btn.setAttribute('aria-selected','true');
  const pane = document.getElementById('code-' + tab);
  if (pane) pane.classList.add('active');
  updateCode();
}

function copyCode() {
  if (!activeComp) return;
  const c = activeComp.code || {};
  const text = { html: c.html, css: c.css, tailwind: c.tailwind, react: c.react }[activeCodeTab] || '';
  navigator.clipboard.writeText(text).catch(() => {});
  const btn = document.getElementById('codeCopyBtn');
  btn.textContent = '✓ Copied!';
  btn.classList.add('done');
  setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('done'); }, 1500);
}

function changeVariant(idx) {
  activeVariantIdx = +idx;
  document.querySelectorAll('#epVariantsBody .prop-chip').forEach((c,i) => c.classList.toggle('active', i===activeVariantIdx));
  updatePreview();
}

function switchVariant(idx, btn) {
  activeVariantIdx = idx;
  document.getElementById('variantSelect').value = idx;
  document.querySelectorAll('#epVariantsBody .prop-chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  updatePreview();
}

function setBg(btn, cls) {
  const area = document.getElementById('dpPreviewArea');
  area.className = 'dp-preview-area ' + cls;
  document.querySelectorAll('.dp-bg-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

function toggleSection(id) {
  const sec = document.getElementById(id);
  const isCollapsed = sec.classList.toggle('collapsed');
  const hd = sec.querySelector('.ep-section-hd');
  if (hd) hd.setAttribute('aria-expanded', !isCollapsed);
}

function updateDetailSaveBtn() {
  const btn = document.getElementById('detailSaveBtn');
  if (!btn || !activeComp) return;
  const saved = savedIds.includes(activeComp.id);
  btn.textContent = saved ? '★ Saved' : '☆ Save';
  btn.style.color = saved ? 'var(--volt)' : '';
  btn.style.borderColor = saved ? 'var(--volt)' : '';
}

function shareComp() {
  if (!activeComp) return;
  const url = `${location.origin}${location.pathname}#${activeComp.id}`;
  navigator.clipboard.writeText(url).catch(()=>{});
  const btn = document.querySelector('.code-share');
  if (btn) { btn.textContent = '✓ Link copied!'; setTimeout(() => btn.textContent = '⬀ Share', 1500); }
}

// ═══════════════════════════════════════════════════════════
// SAVE SYSTEM
// ═══════════════════════════════════════════════════════════
function loadSaved() {
  try { savedIds = JSON.parse(localStorage.getItem('uiblocks-saved') || '[]'); }
  catch(e) { savedIds = []; }
  updateSavedCount();
}

function persistSaved() {
  try { localStorage.setItem('uiblocks-saved', JSON.stringify(savedIds)); }
  catch(e) {}
}

function toggleSaveComp(id) {
  const targetId = id || (activeComp ? activeComp.id : null);
  if (!targetId) return;
  if (savedIds.includes(targetId)) {
    savedIds = savedIds.filter(x => x !== targetId);
  } else {
    savedIds.push(targetId);
  }
  persistSaved();
  updateSavedCount();
  updateDetailSaveBtn();

  // Update grid button if visible
  const btn = document.getElementById('save-' + targetId);
  if (btn) {
    const saved = savedIds.includes(targetId);
    btn.textContent = saved ? '★ Saved' : '☆ Save';
    btn.className = `cc-btn ${saved ? 'saved' : ''}`;
    btn.setAttribute('aria-label', `${saved ? 'Remove from saved' : 'Save'} component`);
  }
  renderSavedList();
}

function updateSavedCount() {
  document.getElementById('savedCount').textContent = savedIds.length;
}

function renderSavedList() {
  const list = document.getElementById('savedList');
  if (savedIds.length === 0) {
    list.innerHTML = `<div class="saved-empty">No saved components yet.<br>Click ☆ on any card to save.</div>`;
    return;
  }
  list.innerHTML = savedIds.map(id => {
    const comp = COMPS.find(c => c.id === id);
    if (!comp) return '';
    const cat = CATS.find(c => c.id === comp.cat);
    return `<div class="saved-item" role="listitem">
      <div style="flex:1">
        <div class="saved-item-name">${comp.name}</div>
        <div class="saved-item-cat">${cat?.label || comp.cat}</div>
      </div>
      <button class="cc-btn primary" style="padding:4px 10px;font-size:7.5px" onclick="openDetail('${id}')" aria-label="Open ${comp.name}">Open</button>
      <button class="saved-item-remove" onclick="toggleSaveComp('${id}')" aria-label="Remove ${comp.name} from saved">×</button>
    </div>`;
  }).join('');
}

function toggleSaved() {
  const panel = document.getElementById('savedPanel');
  panel.classList.toggle('open');
  renderSavedList();
}

function exportSaved(format) {
  const comps = savedIds.map(id => COMPS.find(c => c.id === id)).filter(Boolean);
  if (comps.length === 0) return;

  let content, filename, mime;
  if (format === 'html') {
    content = `<!DOCTYPE html>\n<html lang="en">\n<head><meta charset="UTF-8"><title>Saved Components</title></head>\n<body>\n` +
      comps.map(c => `<!-- ${c.name} -->\n${c.code?.html || ''}\n`).join('\n') +
      `</body>\n</html>`;
    filename = 'uiblocks-saved.html';
    mime = 'text/html';
  } else {
    content = JSON.stringify(comps.map(c => ({ id: c.id, name: c.name, cat: c.cat, code: c.code })), null, 2);
    filename = 'uiblocks-saved.json';
    mime = 'application/json';
  }
  const blob = new Blob([content], { type: mime });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename; a.click();
  URL.revokeObjectURL(url);
}

function clearSaved() {
  savedIds = [];
  persistSaved();
  updateSavedCount();
  renderSavedList();
  renderGrid(activeCategory);
}

// ═══════════════════════════════════════════════════════════
// SEARCH
// ═══════════════════════════════════════════════════════════
function searchComps(q) {
  q = q.toLowerCase().trim();
  const area = document.getElementById('compArea');

  if (!q) { renderGrid(activeCategory); return; }

  let comps = activeCategory === 'all' ? COMPS : COMPS.filter(c => c.cat === activeCategory);
  const matched = comps.filter(c =>
    c.name.toLowerCase().includes(q) ||
    (c.tags || []).some(t => t.toLowerCase().includes(q)) ||
    (CATS.find(cat => cat.id === c.cat)?.label || '').toLowerCase().includes(q)
  );

  document.getElementById('toolbarCount').textContent = `${matched.length} result${matched.length!==1?'s':''}`;
  area.innerHTML = matched.length === 0
    ? `<div class="empty-state"><div class="empty-icon">⌕</div><div class="empty-title">No results</div><div class="empty-desc">Try a different search term</div></div>`
    : matched.map(renderCard).join('');
  area.querySelectorAll('.cc').forEach(el => el.classList.add('anim-in'));
}

// ═══════════════════════════════════════════════════════════
// RANDOM GENERATOR
// ═══════════════════════════════════════════════════════════
function randomComp() {
  const idx = Math.floor(Math.random() * COMPS.length);
  openDetail(COMPS[idx].id);
  const area = document.getElementById('dpPreviewInner');
  area.classList.add('rng-flash');
  setTimeout(() => area.classList.remove('rng-flash'), 400);
}

// ═══════════════════════════════════════════════════════════
// FILTER NEW
// ═══════════════════════════════════════════════════════════
function filterNew() {
  filterOnlyNew = !filterOnlyNew;
  const btn = document.getElementById('filterNewBtn');
  btn.classList.toggle('tbtn', true);
  btn.style.borderColor = filterOnlyNew ? 'var(--volt)' : '';
  btn.style.color = filterOnlyNew ? 'var(--volt)' : '';
  renderGrid(activeCategory);
}

// ═══════════════════════════════════════════════════════════
// VIEW MODE
// ═══════════════════════════════════════════════════════════
function setView(mode) {
  viewMode = mode;
  document.getElementById('vt-grid').classList.toggle('active', mode==='grid');
  document.getElementById('vt-list').classList.toggle('active', mode==='list');
  renderGrid(activeCategory);
}

// ═══════════════════════════════════════════════════════════
// CHALLENGE SYSTEM
// ═══════════════════════════════════════════════════════════
function toggleChallenge() {
  challengeActive = !challengeActive;
  const bar = document.getElementById('challengeBar');
  const btn = document.getElementById('challengeBtn');
  bar.style.display = challengeActive ? 'flex' : 'none';
  btn.classList.toggle('active', challengeActive);
  if (challengeActive) startChallenge();
  else stopChallenge();
}

function startChallenge() {
  const c = CHALLENGES[challengeIdx % CHALLENGES.length];
  document.getElementById('challengeText').innerHTML = c.text;
  challengeSecs = 300;
  updateChallengeTimer();
  clearInterval(challengeTimer);
  challengeTimer = setInterval(() => {
    challengeSecs--;
    updateChallengeTimer();
    if (challengeSecs <= 0) { nextChallenge(); }
  }, 1000);
}

function stopChallenge() {
  clearInterval(challengeTimer);
  challengeTimer = null;
}

function nextChallenge() {
  challengeIdx = (challengeIdx + 1) % CHALLENGES.length;
  startChallenge();
}

function updateChallengeTimer() {
  const m = Math.floor(challengeSecs / 60);
  const s = challengeSecs % 60;
  document.getElementById('challengeTimer').textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

// ═══════════════════════════════════════════════════════════
// KEYBOARD
// ═══════════════════════════════════════════════════════════
function setupKeyboard() {
  document.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      document.getElementById('globalSearch').focus();
    }
    if (e.key === 'Escape') {
      const backdrop = document.getElementById('detailBackdrop');
      if (backdrop.classList.contains('open')) closeDetail();
    }
  });
}

// ═══════════════════════════════════════════════════════════
// UTILS
// ═══════════════════════════════════════════════════════════
function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ═══════════════════════════════════════════════════════════
// THEME TOGGLE
// ═══════════════════════════════════════════════════════════
function toggleTheme() {
  const html = document.documentElement;
  const isDark = html.dataset.theme === 'dark';
  const next = isDark ? 'light' : 'dark';
  html.dataset.theme = next;
  try { localStorage.setItem('uiblocks-theme', next); } catch(e) {}
  updateThemeBtn();
}

function updateThemeBtn() {
  const btn = document.getElementById('themeToggleBtn');
  if (!btn) return;
  const isDark = document.documentElement.dataset.theme === 'dark';
  btn.textContent = isDark ? '☀ Light' : '☾ Dark';
  btn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
}

function initTheme() {
  let theme = 'dark';
  try { theme = localStorage.getItem('uiblocks-theme') || theme; } catch(e) {}
  // Respect system preference if no stored preference
  if (!localStorage.getItem('uiblocks-theme')) {
    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
      theme = 'light';
    }
  }
  document.documentElement.dataset.theme = theme;
  updateThemeBtn();
}

// Run immediately (before DOMContentLoaded to avoid flash)
initTheme();

// Listen for system theme changes
if (window.matchMedia) {
  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', e => {
    // Only auto-switch if user hasn't manually set a preference
    try { if (!localStorage.getItem('uiblocks-theme')) {
      document.documentElement.dataset.theme = e.matches ? 'light' : 'dark';
      updateThemeBtn();
    }} catch(err) {}
  });
}


// ═══════════════════════════════════════════════════════════
// RECENTLY VIEWED
// ═══════════════════════════════════════════════════════════
let recentlyViewed = [];
function trackRecent(id) {
  recentlyViewed = [id, ...recentlyViewed.filter(x => x !== id)].slice(0, 6);
  renderRecentStrip();
}
function renderRecentStrip() {
  const strip = document.getElementById('recentStrip');
  const items = document.getElementById('recentItems');
  if (!items) return;
  if (recentlyViewed.length <= 1) { strip.style.display = 'none'; return; }
  strip.style.display = 'flex';
  items.innerHTML = recentlyViewed.slice(1).map(id => {
    const c = COMPS.find(x => x.id === id);
    return c ? `<button class="recent-item" onclick="openDetail('${id}')" aria-label="Reopen ${c.name}">${c.name}</button>` : '';
  }).join('');
}

// ═══════════════════════════════════════════════════════════
// TOAST FEEDBACK
// ═══════════════════════════════════════════════════════════
let _toastTimeout = null;
function showToast(msg, duration=2000) {
  let t = document.getElementById('globalToast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'globalToast';
    t.className = 'toast-flash';
    t.setAttribute('role','status');
    t.setAttribute('aria-live','polite');
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.animation = 'none';
  t.offsetHeight;
  t.style.animation = 'toastPop .25s ease both';
  clearTimeout(_toastTimeout);
  _toastTimeout = setTimeout(() => {
    t.style.transition = 'opacity .3s';
    t.style.opacity = '0';
    setTimeout(() => { t.style.opacity=''; t.style.transition=''; }, 300);
  }, duration);
}

// ═══════════════════════════════════════════════════════════
// ENHANCED COPY WITH TOAST
// ═══════════════════════════════════════════════════════════
const _origCopyCode = copyCode;
copyCode = function() {
  if (!activeComp) return;
  const c = activeComp.code || {};
  const text = {html:c.html,css:c.css,tailwind:c.tailwind,react:c.react}[activeCodeTab] || '';
  navigator.clipboard.writeText(text).then(() => {
    showToast('✓ ' + activeCodeTab.toUpperCase() + ' copied to clipboard');
    const btn = document.getElementById('codeCopyBtn');
    if (btn) { btn.textContent='✓ Copied!'; btn.classList.add('done'); setTimeout(()=>{btn.textContent='Copy';btn.classList.remove('done');},1500); }
    const pane = document.getElementById('code-' + activeCodeTab);
    if (pane) { pane.classList.add('copy-flash'); setTimeout(()=>pane.classList.remove('copy-flash'),500); }
  }).catch(() => showToast('Copy failed — select text manually'));
};

// ═══════════════════════════════════════════════════════════
// RESPONSIVE PREVIEW WIDTH
// ═══════════════════════════════════════════════════════════
function setPreviewWidth(btn, width) {
  const inner = document.getElementById('dpPreviewInner');
  if (inner) { inner.style.maxWidth=width; inner.style.width=width==='100%'?'100%':width; }
  document.querySelectorAll('.bp-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  showToast('Preview: ' + btn.textContent + ' (' + width + ')');
}

// ═══════════════════════════════════════════════════════════
// MOBILE SIDEBAR
// ═══════════════════════════════════════════════════════════
function toggleMobileSidebar() {
  const sidebar = document.querySelector('.sidebar');
  const overlay = document.getElementById('sidebarOverlay');
  const btn = document.getElementById('mobileSidebarBtn');
  const isOpen = sidebar.classList.toggle('mobile-open');
  if (overlay) overlay.classList.toggle('open', isOpen);
  if (btn) { btn.setAttribute('aria-expanded', isOpen); btn.textContent = isOpen ? '✕' : '≡'; }
}
function closeMobileSidebar() {
  const sidebar = document.querySelector('.sidebar');
  if (sidebar) sidebar.classList.remove('mobile-open');
  const overlay = document.getElementById('sidebarOverlay');
  if (overlay) overlay.classList.remove('open');
  const btn = document.getElementById('mobileSidebarBtn');
  if (btn) { btn.setAttribute('aria-expanded',false); btn.textContent='≡'; }
}
const _origSelectCat = selectCat;
selectCat = function(id,el) { _origSelectCat(id,el); closeMobileSidebar(); };

// ═══════════════════════════════════════════════════════════
// ARROW KEY NAV BETWEEN COMPONENTS
// ═══════════════════════════════════════════════════════════
document.addEventListener('keydown', e => {
  if (!document.getElementById('detailBackdrop').classList.contains('open')) return;
  if (!activeComp) return;
  const cat = activeCategory==='all' ? COMPS : COMPS.filter(c=>c.cat===activeCategory);
  const idx = cat.findIndex(c=>c.id===activeComp.id);
  if (e.key==='ArrowRight'||e.key==='ArrowDown') {
    e.preventDefault();
    const next = cat[(idx+1)%cat.length];
    if (next) { openDetail(next.id); showToast('→ '+next.name); }
  } else if (e.key==='ArrowLeft'||e.key==='ArrowUp') {
    e.preventDefault();
    const prev = cat[(idx-1+cat.length)%cat.length];
    if (prev) { openDetail(prev.id); showToast('← '+prev.name); }
  }
});

// ═══════════════════════════════════════════════════════════
// WRAP openDetail to track recent
// ═══════════════════════════════════════════════════════════
const _origOpenDetail = openDetail;
openDetail = function(id) { _origOpenDetail(id); trackRecent(id); };

// ═══════════════════════════════════════════════════════════
// SAVE TOAST
// ═══════════════════════════════════════════════════════════
const _origToggleSave = toggleSaveComp;
toggleSaveComp = function(id) {
  _origToggleSave(id);
  const targetId = id || (activeComp ? activeComp.id : null);
  if (targetId) showToast(savedIds.includes(targetId) ? '★ Saved to collection' : 'Removed from saved');
};

// ═══════════════════════════════════════════════════════════
// RANDOM TOAST
// ═══════════════════════════════════════════════════════════
const _origRandom = randomComp;
randomComp = function() { _origRandom(); if (activeComp) showToast('🎲 ' + activeComp.name); };

// ═══════════════════════════════════════════════════════════
// THEME TOAST
// ═══════════════════════════════════════════════════════════
const _origToggleTheme = toggleTheme;
toggleTheme = function() {
  _origToggleTheme();
  const isDark = document.documentElement.dataset.theme==='dark';
  showToast(isDark ? '☾ Dark mode' : '☀ Light mode');
};

// ═══════════════════════════════════════════════════════════
// CHALLENGE PROGRESS BAR
// ═══════════════════════════════════════════════════════════
const _origUpdateTimer = updateChallengeTimer;
updateChallengeTimer = function() {
  _origUpdateTimer();
  const pct = (challengeSecs/300)*100;
  let bar = document.getElementById('challengeProgressBar');
  if (!bar) {
    bar = document.createElement('div');
    bar.id = 'challengeProgressBar';
    bar.style.cssText = 'position:absolute;bottom:0;left:0;height:2px;background:var(--volt);transition:width 1s linear;pointer-events:none';
    const cb = document.getElementById('challengeBar');
    if (cb) { cb.style.position='relative'; cb.appendChild(bar); }
  }
  bar.style.width = pct+'%';
  const timer = document.getElementById('challengeTimer');
  if (timer) timer.style.color = challengeSecs<=30 ? 'var(--red)' : 'var(--volt)';
};

// ═══════════════════════════════════════════════════════════
// SKELETON LOADING
// ═══════════════════════════════════════════════════════════
function showSkeletons(n=6) {
  const area = document.getElementById('compArea');
  if (!area) return;
  area.className='comp-area comp-grid-view';
  area.innerHTML=Array.from({length:n},()=>'<div class="skeleton-card"><div class="skeleton-block" style="height:100%"></div></div>').join('');
}
const _origRenderGrid = renderGrid;
renderGrid = function(cat) {
  showSkeletons();
  requestAnimationFrame(()=>requestAnimationFrame(()=>_origRenderGrid(cat)));
};

// ═══════════════════════════════════════════════════════════
// SEARCH HIGHLIGHT
// ═══════════════════════════════════════════════════════════
const _origSearch = searchComps;
searchComps = function(q) {
  _origSearch(q);
  if (!q.trim()) return;
  const re = new RegExp('('+q.replace(/[.*+?^${}()|[\]\\]/g,'\$&')+')','gi');
  document.querySelectorAll('.cc-name').forEach(el => {
    const orig = el.textContent;
    el.innerHTML = orig.replace(re,'<mark style="background:rgba(85,88,240,.3);color:var(--accent);padding:0 2px">$1</mark>');
  });
};

