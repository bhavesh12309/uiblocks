<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UIBlocks — Component Library | Live Preview + Editor</title>
<meta name="description" content="Production-ready UI component library with live prop editing, 4-format code output (HTML, CSS, Tailwind, React), save, share, random generator and daily challenges.">
<meta property="og:title" content="UIBlocks — Editable Component Library">
<meta property="og:description" content="Live-editable UI components. Edit colors, spacing, shadows. Copy as HTML, CSS, Tailwind or React. Save, share, challenge.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:wght@400;700&family=Barlow+Condensed:ital,wght@0,400;0,700;0,900;1,400&display=swap" rel="stylesheet">
<style>
/* ── TOKENS ─────────────────────────────── */
:root{
  /* shared */
  --accent:#5558f0;--accent2:#a78bfa;--volt:#f5e642;
  --green:#22c55e;--red:#ef4444;--amber:#f59e0b;
  --display:'Bebas Neue',sans-serif;
  --mono:'Space Mono',monospace;
  --sans:'Barlow Condensed',sans-serif;
  --sidebar-w:248px;--header-h:52px;--panel-w:300px;
  --t:all .18s ease;
  --radius:0px;
}
/* ── DARK THEME (default) ── */
[data-theme="dark"]{
  --bg:#080807;--surface:#111110;--surface2:#191918;--surface3:#222220;
  --text:#f0ede8;--text2:#a09890;--text3:#8a8580;
  --rule:rgba(240,237,232,.07);--rule-s:rgba(240,237,232,.14);
  --ink-faint:rgba(240,237,232,.025);
  --shadow:rgba(0,0,0,.45);
  --cc-preview-bg:#0a0a09;
}
/* ── LIGHT THEME ── */
[data-theme="light"]{
  --bg:#f5f2ed;--surface:#ede9e2;--surface2:#e2ddd7;--surface3:#d5cfc8;
  --text:#0f0e0d;--text2:#4a4540;--text3:#636059;
  --rule:rgba(15,14,13,.08);--rule-s:rgba(15,14,13,.15);
  --ink-faint:rgba(15,14,13,.025);
  --shadow:rgba(0,0,0,.12);
  --cc-preview-bg:#e8e4de;
}
/* ── System preference fallback ── */
@media(prefers-color-scheme:light){
  :root:not([data-theme]){
    --bg:#f5f2ed;--surface:#ede9e2;--surface2:#e2ddd7;--surface3:#d5cfc8;
    --text:#0f0e0d;--text2:#4a4540;--text3:#636059;
    --rule:rgba(15,14,13,.08);--rule-s:rgba(15,14,13,.15);
    --ink-faint:rgba(15,14,13,.025);
    --shadow:rgba(0,0,0,.12);
    --cc-preview-bg:#e8e4de;
  }
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{height:100%}
body{font-family:var(--sans);background:var(--bg);color:var(--text);height:100%;overflow:hidden;display:flex;flex-direction:column;transition:background .22s,color .22s}
a{color:inherit;text-decoration:none}
button{cursor:pointer;border:none;background:none;font:inherit;color:inherit}
input,select,textarea{font:inherit;color:inherit}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--rule-s);border-radius:2px}
::-webkit-scrollbar-thumb:hover{background:var(--text3)}

/* ── HEADER ─────────────────────────────── */
.header{height:var(--header-h);display:flex;align-items:center;justify-content:space-between;padding:0 20px 0 16px;border-bottom:1px solid var(--rule-s);background:var(--bg);flex-shrink:0;gap:12px;z-index:50}
.header-brand{display:flex;align-items:center;gap:10px;flex-shrink:0}
.brand-logo{font-family:var(--display);font-size:28px;letter-spacing:.06em;line-height:1;color:var(--text)}
.brand-logo span{color:var(--accent)}
.brand-tag{font-family:var(--mono);font-size:8px;letter-spacing:.2em;text-transform:uppercase;color:var(--text3);padding:3px 8px;border:1px solid var(--rule-s)}
.header-search{flex:1;max-width:360px;display:flex;align-items:center;background:var(--surface);border:1px solid var(--rule-s);gap:8px;padding:0 12px;transition:border-color .15s}
.header-search:focus-within{border-color:var(--accent)}
.header-search input{flex:1;background:none;border:none;outline:none;font-family:var(--mono);font-size:11px;color:var(--text);padding:8px 0}
.header-search input::placeholder{color:var(--text3)}
.header-search-icon{color:var(--text3);font-size:13px;flex-shrink:0}
.header-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
.hbtn{font-family:var(--mono);font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;padding:6px 14px;border:1px solid var(--rule-s);color:var(--text3);transition:var(--t);display:flex;align-items:center;gap:6px;white-space:nowrap}
.hbtn:hover{border-color:var(--accent);color:var(--accent)}
.hbtn.active,.hbtn-volt{border-color:var(--volt);color:var(--volt)}
.hbtn-volt:hover{background:var(--volt);color:#000}
.hbtn-accent{border-color:var(--accent);color:var(--accent)}
.hbtn-accent:hover{background:var(--accent);color:#fff}
.saved-count{background:var(--accent);color:#fff;font-size:8px;padding:1px 5px;border-radius:10px;font-family:var(--mono);min-width:14px;text-align:center}

/* ── LAYOUT ─────────────────────────────── */
.app-body{display:flex;flex:1;overflow:hidden}

/* ── SIDEBAR ─────────────────────────────── */
.sidebar{width:var(--sidebar-w);flex-shrink:0;border-right:1px solid var(--rule-s);display:flex;flex-direction:column;background:var(--surface);overflow:hidden}
.sidebar-hd{padding:12px 14px 8px;border-bottom:1px solid var(--rule);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.sidebar-hd-label{font-family:var(--mono);font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:var(--text3)}
.sidebar-hd-count{font-family:var(--mono);font-size:9px;color:var(--accent)}
.sidebar-scroll{flex:1;overflow-y:auto;padding:8px 0}
.sidebar-cat-hd{font-family:var(--mono);font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:var(--text3);padding:10px 14px 4px;display:flex;align-items:center;gap:8px}
.sidebar-cat-hd::after{content:'';flex:1;height:1px;background:var(--rule)}
.sidebar-item{display:flex;align-items:center;justify-content:space-between;padding:7px 14px;font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:var(--text3);cursor:pointer;transition:var(--t);gap:8px}
.sidebar-item:hover{color:var(--text2);background:var(--ink-faint)}
.sidebar-item.active{color:var(--accent);background:rgba(85,88,240,.07);border-left:2px solid var(--accent);padding-left:12px}
.sidebar-item .si-count{font-size:8.5px;background:var(--surface3);border:1px solid var(--rule-s);padding:1px 6px;color:var(--text3);flex-shrink:0}
.sidebar-item.active .si-count{background:rgba(85,88,240,.15);border-color:rgba(85,88,240,.3);color:var(--accent)}

/* ── MAIN CONTENT ────────────────────────── */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden}
.main-toolbar{height:44px;display:flex;align-items:center;justify-content:space-between;padding:0 20px;border-bottom:1px solid var(--rule);flex-shrink:0;gap:12px;background:var(--surface)}
.toolbar-left{display:flex;align-items:center;gap:8px}
.toolbar-title{font-family:var(--display);font-size:22px;letter-spacing:.05em;color:var(--text)}
.toolbar-title span{color:var(--accent)}
.toolbar-pill{font-family:var(--mono);font-size:8px;letter-spacing:.14em;text-transform:uppercase;padding:3px 9px;border:1px solid var(--rule-s);color:var(--text3)}
.toolbar-right{display:flex;align-items:center;gap:6px}
.view-toggle{display:flex;border:1px solid var(--rule-s)}
.vt-btn{font-family:var(--mono);font-size:10px;padding:5px 10px;color:var(--text3);transition:var(--t);border-right:1px solid var(--rule-s)}
.vt-btn:last-child{border-right:none}
.vt-btn:hover{color:var(--text2)}
.vt-btn.active{background:var(--surface3);color:var(--text)}
.tbtn{font-family:var(--mono);font-size:8.5px;letter-spacing:.12em;text-transform:uppercase;padding:5px 11px;border:1px solid var(--rule-s);color:var(--text3);transition:var(--t);display:flex;align-items:center;gap:5px;white-space:nowrap}
.tbtn:hover{border-color:var(--accent);color:var(--accent)}
.tbtn.volt{border-color:var(--volt);color:var(--volt)}
.tbtn.volt:hover{background:var(--volt);color:#000}

/* ── COMPONENT GRID ──────────────────────── */
.comp-area{flex:1;overflow-y:auto;padding:20px}
.comp-grid-view{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px}
.comp-list-view{display:flex;flex-direction:column;gap:8px}

/* ── COMPONENT CARD ──────────────────────── */
.cc{background:var(--surface);border:1px solid var(--rule-s);display:flex;flex-direction:column;transition:border-color .18s,box-shadow .18s;position:relative;overflow:hidden}
.cc:hover{border-color:rgba(85,88,240,.4);box-shadow:0 4px 24px rgba(0,0,0,.3)}
.cc-top-bar{height:2px;background:var(--cc-color,var(--accent));transform:scaleX(0);transform-origin:left;transition:transform .25s}
.cc:hover .cc-top-bar{transform:scaleX(1)}
.cc-preview{background:var(--bg);min-height:160px;display:flex;align-items:center;justify-content:center;padding:20px;position:relative;overflow:hidden;cursor:pointer}
.cc-preview-grid{position:absolute;inset:0;background-image:repeating-linear-gradient(0deg,transparent,transparent 23px,rgba(240,237,232,.03) 23px,rgba(240,237,232,.03) 24px),repeating-linear-gradient(90deg,transparent,transparent 23px,rgba(240,237,232,.03) 23px,rgba(240,237,232,.03) 24px);pointer-events:none}
.cc-preview iframe{width:100%;height:140px;border:none;pointer-events:none;background:var(--cc-preview-bg)}
.cc-preview .cc-expand-hint{position:absolute;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:#fff;opacity:0;transition:opacity .15s}
.cc:hover .cc-expand-hint{opacity:1}
.cc-meta{padding:10px 14px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--rule);gap:8px}
.cc-name{font-family:var(--sans);font-size:13.5px;font-weight:700;color:var(--text)}
.cc-tags{display:flex;gap:4px;flex-wrap:wrap}
.cc-tag{font-family:var(--mono);font-size:7.5px;letter-spacing:.1em;text-transform:uppercase;padding:2px 6px;border:1px solid var(--rule-s);color:var(--text3);background:var(--surface2)}
.cc-actions{padding:8px 14px 12px;display:flex;gap:6px;border-top:1px solid var(--rule)}
.cc-btn{font-family:var(--mono);font-size:8px;letter-spacing:.12em;text-transform:uppercase;padding:5px 10px;border:1px solid var(--rule-s);color:var(--text3);transition:var(--t);flex:1;text-align:center}
.cc-btn:hover{border-color:var(--accent);color:var(--accent)}
.cc-btn.primary{border-color:var(--accent);color:var(--accent)}
.cc-btn.primary:hover{background:var(--accent);color:#fff}
.cc-btn.saved{border-color:var(--green);color:var(--green)}

/* ── LIST VIEW CARD ──────────────────────── */
.cc-list{background:var(--surface);border:1px solid var(--rule-s);display:flex;align-items:center;gap:14px;padding:12px 16px;transition:border-color .15s;cursor:pointer}
.cc-list:hover{border-color:rgba(85,88,240,.4)}
.cc-list-preview{width:80px;height:48px;flex-shrink:0;background:var(--bg);border:1px solid var(--rule);display:flex;align-items:center;justify-content:center;overflow:hidden}
.cc-list-name{font-family:var(--sans);font-size:14px;font-weight:700;color:var(--text);margin-bottom:3px}
.cc-list-meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.cc-list-actions{display:flex;gap:6px;margin-left:auto;flex-shrink:0}

/* ── DETAIL MODAL ────────────────────────── */
.detail-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:200;display:none;backdrop-filter:blur(6px)}
.detail-backdrop.open{display:flex}
.detail-panel{position:absolute;inset:0;display:flex;flex-direction:column}
.detail-header{height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 20px;border-bottom:1px solid var(--rule-s);background:var(--surface);flex-shrink:0;gap:12px}
.detail-title{font-family:var(--display);font-size:26px;letter-spacing:.04em;color:var(--text)}
.detail-close{font-family:var(--mono);font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;padding:6px 14px;border:1px solid var(--rule-s);color:var(--text3);transition:var(--t)}
.detail-close:hover{border-color:var(--text3);color:var(--text)}
.detail-body{display:flex;flex:1;overflow:hidden}

/* preview pane */
.detail-preview-pane{flex:1;display:flex;flex-direction:column;overflow:hidden;border-right:1px solid var(--rule-s)}
.dp-toolbar{height:40px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;border-bottom:1px solid var(--rule);background:var(--surface2);flex-shrink:0}
.dp-toolbar-left{display:flex;align-items:center;gap:6px}
.dp-label{font-family:var(--mono);font-size:8px;letter-spacing:.18em;text-transform:uppercase;color:var(--text3)}
.dp-variant-select{font-family:var(--mono);font-size:9px;background:var(--surface);border:1px solid var(--rule-s);color:var(--text);padding:3px 8px;outline:none;cursor:pointer;transition:border-color .15s}
.dp-variant-select:focus{border-color:var(--accent)}
.dp-bg-toggle{display:flex;border:1px solid var(--rule-s)}
.dp-bg-btn{font-family:var(--mono);font-size:9px;padding:3px 8px;color:var(--text3);border-right:1px solid var(--rule-s);transition:var(--t)}
.dp-bg-btn:last-child{border-right:none}
.dp-bg-btn.active{background:var(--surface3);color:var(--text)}
.dp-preview-area{flex:1;overflow:auto;display:flex;align-items:center;justify-content:center;padding:32px;background:var(--bg);position:relative}
.dp-preview-area.bg-white{background:#ffffff}
.dp-preview-area.bg-gray{background:#f3f4f6}
.dp-preview-area.bg-dark{background:#0f0e0d}
.dp-preview-area.bg-checker{background-image:repeating-conic-gradient(rgba(255,255,255,.05) 0% 25%,transparent 0% 50%);background-size:20px 20px}
.dp-preview-inner{max-width:860px;width:100%;display:flex;align-items:center;justify-content:center;position:relative;z-index:1}

/* editor pane */
.detail-editor-pane{width:300px;flex-shrink:0;display:flex;flex-direction:column;background:var(--surface);overflow:hidden}
.ep-section{border-bottom:1px solid var(--rule);flex-shrink:0}
.ep-section-hd{font-family:var(--mono);font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:var(--text3);padding:9px 14px;display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none;transition:background .12s}
.ep-section-hd:hover{background:rgba(240,237,232,.03)}
.ep-section-hd::before{content:'';width:3px;height:10px;background:var(--accent);display:block}
.ep-section-hd .ep-arrow{margin-left:auto;transition:transform .2s;font-size:10px;color:var(--text3)}
.ep-section-body{padding:10px 14px 12px;display:flex;flex-direction:column;gap:10px}
.ep-section.collapsed .ep-section-body{display:none}
.ep-section.collapsed .ep-arrow{transform:rotate(-90deg)}

/* prop controls */
.prop-row{display:flex;flex-direction:column;gap:5px}
.prop-label{font-family:var(--mono);font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3);display:flex;align-items:center;justify-content:space-between}
.prop-val{color:var(--text2);font-weight:700}
.prop-color{display:flex;align-items:center;gap:8px}
.prop-color input[type=color]{width:32px;height:28px;border:1px solid var(--rule-s);background:var(--bg);cursor:pointer;padding:2px}
.prop-color input[type=text]{flex:1;font-family:var(--mono);font-size:10px;background:var(--bg);border:1px solid var(--rule-s);padding:5px 8px;color:var(--text);outline:none;transition:border-color .15s}
.prop-color input[type=text]:focus{border-color:var(--accent)}
input[type=range]{width:100%;accent-color:var(--accent);height:3px;cursor:pointer}
.prop-select{width:100%;font-family:var(--mono);font-size:10px;background:var(--bg);border:1px solid var(--rule-s);color:var(--text);padding:6px 8px;outline:none;cursor:pointer;appearance:none;transition:border-color .15s}
.prop-select:focus{border-color:var(--accent)}
.prop-chips{display:flex;gap:4px;flex-wrap:wrap}
.prop-chip{font-family:var(--mono);font-size:8px;letter-spacing:.1em;text-transform:uppercase;padding:3px 9px;border:1px solid var(--rule-s);color:var(--text3);cursor:pointer;transition:var(--t)}
.prop-chip:hover{color:var(--text2);border-color:var(--text3)}
.prop-chip.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.prop-toggle-row{display:flex;align-items:center;justify-content:space-between}
.prop-toggle{width:36px;height:20px;background:var(--surface3);border:1px solid var(--rule-s);position:relative;cursor:pointer;transition:all .18s;flex-shrink:0}
.prop-toggle::after{content:'';position:absolute;left:2px;top:2px;width:14px;height:14px;background:var(--text3);transition:all .18s}
.prop-toggle.on{background:var(--accent);border-color:var(--accent)}
.prop-toggle.on::after{left:18px;background:#fff}
.ep-reset-btn{font-family:var(--mono);font-size:8px;letter-spacing:.12em;text-transform:uppercase;padding:5px 12px;border:1px solid var(--rule-s);color:var(--text3);width:100%;transition:var(--t);margin-top:4px}
.ep-reset-btn:hover{border-color:var(--amber);color:var(--amber)}

/* code panel */
.detail-code-pane{flex-shrink:0;border-top:1px solid var(--rule-s);background:var(--bg)}
.code-tabs{display:flex;border-bottom:1px solid var(--rule-s)}
.code-tab{font-family:var(--mono);font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;padding:8px 16px;color:var(--text3);cursor:pointer;border-right:1px solid var(--rule);transition:color .15s;position:relative;flex:1;text-align:center}
.code-tab::after{content:'';position:absolute;bottom:-1px;left:0;right:0;height:2px;background:transparent;transition:background .15s}
.code-tab:hover{color:var(--text2)}
.code-tab.active{color:var(--text);background:var(--surface)}
.code-tab[data-tab=html].active::after{background:#f97316}
.code-tab[data-tab=css].active::after{background:var(--accent)}
.code-tab[data-tab=tailwind].active::after{background:#06b6d4}
.code-tab[data-tab=react].active::after{background:#61dafb}
.code-pane{display:none;max-height:180px;overflow:auto}
.code-pane.active{display:block}
.code-block{font-family:var(--mono);font-size:11px;line-height:1.7;padding:14px 16px;white-space:pre-wrap;word-break:break-all;color:var(--text2)}
.code-block .kw{color:#c792ea}.code-block .str{color:#c3e88d}.code-block .cm{color:var(--text3);font-style:italic}.code-block .attr{color:#89ddff}.code-block .cls{color:#82aaff}.code-block .val{color:#f78c6c}
.code-actions{display:flex;align-items:center;justify-content:space-between;padding:6px 12px;border-top:1px solid var(--rule);background:var(--surface)}
.code-meta{font-family:var(--mono);font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:var(--text3)}
.code-btns{display:flex;gap:6px}
.code-copy{font-family:var(--mono);font-size:8px;letter-spacing:.14em;text-transform:uppercase;padding:5px 12px;border:1px solid var(--accent);color:var(--accent);transition:var(--t)}
.code-copy:hover,.code-copy.done{background:var(--accent);color:#fff}
.code-share{font-family:var(--mono);font-size:8px;letter-spacing:.14em;text-transform:uppercase;padding:5px 10px;border:1px solid var(--rule-s);color:var(--text3);transition:var(--t)}
.code-share:hover{border-color:var(--text3);color:var(--text)}

/* ── CHALLENGE PANEL ─────────────────────── */
.challenge-bar{background:var(--surface);border-bottom:1px solid var(--rule-s);padding:10px 20px;display:flex;align-items:center;gap:14px;flex-shrink:0}
.challenge-tag{font-family:var(--mono);font-size:8px;letter-spacing:.2em;text-transform:uppercase;padding:3px 10px;background:rgba(245,230,66,.12);border:1px solid rgba(245,230,66,.3);color:var(--volt)}
.challenge-text{font-family:var(--sans);font-size:13px;font-style:italic;color:var(--text2);flex:1}
.challenge-text strong{color:var(--volt);font-style:normal}
.challenge-timer{font-family:var(--mono);font-size:16px;color:var(--volt);letter-spacing:.08em;flex-shrink:0}
.challenge-skip{font-family:var(--mono);font-size:8px;letter-spacing:.12em;text-transform:uppercase;padding:5px 12px;border:1px solid rgba(245,230,66,.3);color:var(--volt);transition:var(--t)}
.challenge-skip:hover{background:rgba(245,230,66,.1)}

/* ── SAVED PANEL ─────────────────────────── */
.saved-panel{position:fixed;top:var(--header-h);right:-340px;width:320px;height:calc(100vh - var(--header-h));background:var(--surface);border-left:1px solid var(--rule-s);z-index:100;transition:right .3s ease;display:flex;flex-direction:column}
.saved-panel.open{right:0}
.saved-panel-hd{padding:14px 16px;border-bottom:1px solid var(--rule);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.saved-panel-title{font-family:var(--display);font-size:22px;letter-spacing:.04em;color:var(--text)}
.saved-panel-close{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;padding:5px 10px;border:1px solid var(--rule-s);color:var(--text3);transition:var(--t)}
.saved-panel-close:hover{border-color:var(--text3);color:var(--text)}
.saved-list{flex:1;overflow-y:auto;padding:12px}
.saved-item{background:var(--surface2);border:1px solid var(--rule-s);margin-bottom:8px;padding:10px 12px;display:flex;align-items:center;gap:10px;transition:border-color .15s}
.saved-item:hover{border-color:rgba(85,88,240,.4)}
.saved-item-name{font-family:var(--sans);font-size:13px;font-weight:700;color:var(--text);flex:1}
.saved-item-cat{font-family:var(--mono);font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:var(--text3)}
.saved-item-remove{font-family:var(--mono);font-size:12px;color:var(--text3);cursor:pointer;transition:color .15s;flex-shrink:0}
.saved-item-remove:hover{color:var(--red)}
.saved-empty{text-align:center;padding:40px 20px;font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3)}
.saved-actions{padding:12px;border-top:1px solid var(--rule);display:flex;gap:8px;flex-shrink:0}
.saved-export{font-family:var(--mono);font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;padding:7px 0;border:1px solid var(--rule-s);color:var(--text3);flex:1;text-align:center;transition:var(--t)}
.saved-export:hover{border-color:var(--accent);color:var(--accent)}

/* ── EMPTY / LOADING STATES ──────────────── */
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:300px;gap:16px;padding:40px}
.empty-icon{font-size:40px;opacity:.4}
.empty-title{font-family:var(--display);font-size:32px;letter-spacing:.04em;color:var(--text);opacity:.4}
.empty-desc{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3);text-align:center}

/* ── RANDOM GENERATOR ────────────────────── */
.rng-flash{animation:rngFlash .4s ease both}
@keyframes rngFlash{0%{opacity:0;transform:scale(.97)}100%{opacity:1;transform:scale(1)}}

/* ── MISC ────────────────────────────────── */
.dot{width:6px;height:6px;border-radius:50%;display:inline-block}
.dot-green{background:var(--green)}
.dot-volt{background:var(--volt)}
.dot-accent{background:var(--accent)}
.badge{font-family:var(--mono);font-size:7.5px;letter-spacing:.1em;text-transform:uppercase;padding:2px 7px;border:1px solid}
.badge-new{color:var(--volt);border-color:rgba(245,230,66,.4);background:rgba(245,230,66,.08)}
.kbd{font-family:var(--mono);font-size:9px;padding:2px 6px;border:1px solid var(--rule-s);background:var(--surface2);color:var(--text3)}

@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.anim-in{animation:fadeIn .25s ease both}
.anim-in:nth-child(2){animation-delay:.04s}
.anim-in:nth-child(3){animation-delay:.08s}
.anim-in:nth-child(4){animation-delay:.12s}
.anim-in:nth-child(5){animation-delay:.16s}
.anim-in:nth-child(6){animation-delay:.20s}

/* ── RESPONSIVE ──────────────────────────── */
@media(max-width:900px){
  .sidebar{display:none}
  .detail-editor-pane{width:260px}
  .header-search{display:none}
}

/* ── ENHANCED POLISH ─────────────────────────────────── */
@keyframes slideUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@keyframes slideRight{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:none}}
@keyframes popIn{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:scale(1)}}
@keyframes shimmer{from{background-position:200% 0}to{background-position:-200% 0}}
.header{animation:slideUp .3s ease both}
.sidebar{animation:slideRight .3s .05s ease both}
.main{animation:slideUp .3s .08s ease both}
*:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.cc{transform:translateY(0);transition:border-color .18s,box-shadow .22s,transform .22s}
.cc:hover{transform:translateY(-3px);box-shadow:0 8px 32px var(--shadow),0 2px 8px rgba(85,88,240,.12)}
[data-theme="light"] .cc:hover{box-shadow:0 8px 24px rgba(0,0,0,.1),0 2px 8px rgba(85,88,240,.08)}
.brand-logo{background:linear-gradient(135deg,var(--text) 40%,var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
[data-theme="light"] .brand-logo{background:linear-gradient(135deg,var(--text) 30%,var(--accent));-webkit-background-clip:text;background-clip:text}
.sidebar-item{border-left:2px solid transparent;transition:color .15s,background .15s,border-color .15s,padding-left .15s}
.sidebar-item.active{border-left-color:var(--accent)}
.sidebar-item:hover:not(.active){border-left-color:rgba(85,88,240,.3)}
.header-search:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px rgba(85,88,240,.12)}
.code-tab{position:relative}
.code-tab::before{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--tab-c,var(--accent));transform:scaleX(0);transition:transform .2s}
.code-tab.active::before{transform:scaleX(1)}
.code-tab[data-tab=html]{--tab-c:#f97316}
.code-tab[data-tab=css]{--tab-c:var(--accent)}
.code-tab[data-tab=tailwind]{--tab-c:#06b6d4}
.code-tab[data-tab=react]{--tab-c:#61dafb}
.copy-flash{animation:copyFlash .5s ease both}
@keyframes copyFlash{0%{background:rgba(85,88,240,.2)}100%{background:transparent}}
.toast-flash{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--surface);border:1.5px solid var(--accent);color:var(--text);font-family:var(--mono);font-size:9px;letter-spacing:.18em;text-transform:uppercase;padding:10px 20px;z-index:9999;animation:toastPop .25s ease both;pointer-events:none;white-space:nowrap;box-shadow:0 8px 24px var(--shadow)}
@keyframes toastPop{from{opacity:0;transform:translateX(-50%) translateY(8px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
.skeleton-card{background:var(--surface);border:1px solid var(--rule-s);height:240px}
.skeleton-block{background:linear-gradient(90deg,var(--surface2) 25%,var(--surface3) 50%,var(--surface2) 75%);background-size:200% 100%;animation:shimmer 1.6s infinite}
.ep-section-hd{background:var(--surface2)}
.ep-section-hd:hover{background:var(--surface3)}
.prop-row+.prop-row{padding-top:8px;border-top:1px solid var(--rule)}
.detail-backdrop{transition:opacity .2s;display:flex!important}
.detail-backdrop:not(.open){opacity:0;pointer-events:none}
.detail-backdrop.open{opacity:1}
.detail-panel{animation:popIn .22s ease both}
.saved-panel{transition:right .28s cubic-bezier(.4,0,.2,1)}
.dp-preview-area{transition:background .2s}
.dp-preview-area.bg-checker{background-color:var(--surface2);background-image:repeating-conic-gradient(var(--surface3) 0% 25%,transparent 0% 50%);background-size:20px 20px}
.mobile-sidebar-toggle{display:none;font-family:var(--mono);font-size:18px;padding:6px 10px;border:1px solid var(--rule-s);color:var(--text3);background:none;cursor:pointer;transition:var(--t)}
.mobile-sidebar-toggle:hover{color:var(--text)}
@media(max-width:900px){
  .mobile-sidebar-toggle{display:flex;align-items:center}
  .sidebar{position:fixed;top:var(--header-h);left:0;bottom:0;z-index:80;transform:translateX(-100%);transition:transform .28s cubic-bezier(.4,0,.2,1)}
  .sidebar.mobile-open{transform:translateX(0);box-shadow:8px 0 32px var(--shadow)}
  .sidebar-overlay{display:none;position:fixed;inset:0;top:var(--header-h);background:rgba(0,0,0,.5);z-index:79}
  .sidebar-overlay.open{display:block}
}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--rule-s)}
@media print{
  .header,.sidebar,.saved-panel,.detail-backdrop,.mobile-sidebar-toggle,.challenge-bar{display:none!important}
  .comp-area{overflow:visible;height:auto}
  .cc{break-inside:avoid}
}
.sidebar,.main-toolbar,.detail-header,.detail-editor-pane,.ep-section,.code-actions,.code-tabs,.header,.cc,.cc-meta,.cc-actions,.ep-section-hd,.saved-panel,.challenge-bar{transition:background .22s,border-color .22s,color .22s}
.bp-bar{display:flex;align-items:center;gap:4px;padding:0 16px;height:36px;border-bottom:1px solid var(--rule);background:var(--surface2);flex-shrink:0;overflow-x:auto}
.bp-btn{font-family:var(--mono);font-size:8px;letter-spacing:.14em;text-transform:uppercase;padding:4px 10px;border:1px solid var(--rule-s);color:var(--text3);cursor:pointer;transition:var(--t);white-space:nowrap}
.bp-btn:hover{border-color:var(--accent);color:var(--accent)}
.bp-btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.recent-strip{display:flex;align-items:center;gap:6px;padding:8px 14px;border-bottom:1px solid var(--rule);background:var(--surface);flex-shrink:0}
.recent-label{font-family:var(--mono);font-size:8px;letter-spacing:.2em;text-transform:uppercase;color:var(--text3)}
.recent-item{font-family:var(--mono);font-size:8.5px;letter-spacing:.08em;padding:3px 9px;border:1px solid var(--rule-s);color:var(--text3);cursor:pointer;transition:var(--t);white-space:nowrap}
.recent-item:hover{border-color:var(--accent);color:var(--accent)}
</style>
</head>
<body>

<!-- SKIP LINK -->
<a href="#main-content" style="position:absolute;top:-40px;left:0;background:var(--accent);color:#fff;padding:8px 16px;font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;z-index:999;transition:top .2s" onfocus="this.style.top='0'" onblur="this.style.top='-40px'">Skip to content</a>

<!-- HEADER -->
<header class="header" role="banner">
  <div class="header-brand">
    <div class="brand-logo">UI<span>BLOCKS</span></div>
    <div class="brand-tag">Component Library</div>
  </div>
  <div class="header-search" role="search">
    <span class="header-search-icon" aria-hidden="true">⌕</span>
    <input type="search" id="globalSearch" placeholder="Search components… (⌘K)" aria-label="Search all components" oninput="searchComps(this.value)" autocomplete="off">
    <span class="kbd" aria-hidden="true">⌘K</span>
  </div>
  <div class="header-actions">
    <button class="hbtn hbtn-volt" id="challengeBtn" onclick="toggleChallenge()" aria-label="Toggle daily challenge mode">⚡ Challenge</button>
    <button class="hbtn" id="rngBtn" onclick="randomComp()" aria-label="Open random component" title="Random component">🎲 Random</button>
    <button class="hbtn hbtn-accent" id="savedBtn" onclick="toggleSaved()" aria-label="Open saved components">
      ★ Saved <span class="saved-count" id="savedCount">0</span>
    </button>
    <button class="hbtn" id="themeToggleBtn" onclick="toggleTheme()" aria-label="Toggle light and dark theme" title="Toggle theme">☀ / ☾</button>
    <a href="uiforge.html" class="hbtn" aria-label="Back to UIForge CSS tools">← UIForge</a>
  </div>
</header>

<!-- CHALLENGE BAR (hidden by default) -->
<div class="challenge-bar" id="challengeBar" style="display:none" role="banner" aria-live="polite">
  <div class="challenge-tag">⚡ Daily Challenge</div>
  <div class="challenge-text" id="challengeText">Loading challenge…</div>
  <div class="challenge-timer" id="challengeTimer">05:00</div>
  <button class="challenge-skip" onclick="nextChallenge()" aria-label="Skip to next challenge">Skip →</button>
</div>

<!-- APP BODY -->
<div class="app-body">

  <!-- SIDEBAR -->
  <nav class="sidebar" aria-label="Component categories">
    <div class="sidebar-hd">
      <span class="sidebar-hd-label">Categories</span>
      <span class="sidebar-hd-count" id="sidebarCount">0 components</span>
    </div>
    <div class="sidebar-scroll" id="sidebarNav" role="list"></div>
  </nav>

  <!-- MAIN -->
  <main class="main" id="main-content">
    <div class="main-toolbar">
      <div class="toolbar-left">
        <div class="toolbar-title" id="toolbarTitle">ALL <span>COMPONENTS</span></div>
        <div class="toolbar-pill" id="toolbarCount">0</div>
      </div>
      <div class="toolbar-right">
        <div class="view-toggle" role="group" aria-label="View mode">
          <button class="vt-btn active" id="vt-grid" onclick="setView('grid')" aria-label="Grid view">⊞ Grid</button>
          <button class="vt-btn" id="vt-list" onclick="setView('list')" aria-label="List view">≡ List</button>
        </div>
        <button class="tbtn volt" onclick="randomComp()" aria-label="Randomise component">🎲 Randomise</button>
        <button class="tbtn" id="filterNewBtn" onclick="filterNew()" aria-label="Show new components">
          <span class="dot dot-volt"></span> New
        </button>
      </div>
    </div>
    <div class="comp-area" id="compArea" role="list" aria-label="Component cards"></div>
  </main>
</div>

<!-- SAVED PANEL -->
<aside class="saved-panel" id="savedPanel" aria-label="Saved components">
  <div class="saved-panel-hd">
    <div class="saved-panel-title">SAVED</div>
    <button class="saved-panel-close" onclick="toggleSaved()" aria-label="Close saved panel">✕ Close</button>
  </div>
  <div class="saved-list" id="savedList" role="list"></div>
  <div class="saved-actions">
    <button class="saved-export" onclick="exportSaved('html')" aria-label="Export saved as HTML">↓ HTML</button>
    <button class="saved-export" onclick="exportSaved('json')" aria-label="Export saved as JSON">↓ JSON</button>
    <button class="saved-export" onclick="clearSaved()" style="color:var(--red);border-color:rgba(239,68,68,.3)" aria-label="Clear all saved">Clear all</button>
  </div>
</aside>

<!-- DETAIL MODAL -->
<div class="detail-backdrop" id="detailBackdrop" role="dialog" aria-modal="true" aria-labelledby="detailTitle" onclick="closeDetail(event)">
  <div class="detail-panel">
    <div class="detail-header">
      <div class="detail-title" id="detailTitle">Component</div>
      <div style="display:flex;align-items:center;gap:8px">
        <button class="hbtn" id="detailSaveBtn" onclick="toggleSaveComp()" aria-label="Save component">★ Save</button>
        <button class="hbtn" onclick="shareComp()" aria-label="Share component">⬀ Share</button>
        <button class="detail-close" onclick="closeDetail()" aria-label="Close detail view">✕ Close</button>
      </div>
    </div>
    <div class="detail-body">
      <!-- Preview pane -->
      <div class="detail-preview-pane">
        <div class="dp-toolbar">
          <div class="dp-toolbar-left">
            <span class="dp-label">Variant:</span>
            <select class="dp-variant-select" id="variantSelect" onchange="changeVariant(this.value)" aria-label="Select component variant"></select>
          </div>
          <div style="display:flex;align-items:center;gap:8px">
            <span class="dp-label">Background:</span>
            <div class="dp-bg-toggle" role="group" aria-label="Preview background">
              <button class="dp-bg-btn active" data-bg="bg-dark" onclick="setBg(this,'bg-dark')" aria-label="Dark background">Dark</button>
              <button class="dp-bg-btn" data-bg="bg-white" onclick="setBg(this,'bg-white')" aria-label="White background">White</button>
              <button class="dp-bg-btn" data-bg="bg-gray" onclick="setBg(this,'bg-gray')" aria-label="Gray background">Gray</button>
              <button class="dp-bg-btn" data-bg="bg-checker" onclick="setBg(this,'bg-checker')" aria-label="Checker background">Check</button>
            </div>
          </div>
        </div>
        <div class="dp-preview-area bg-dark" id="dpPreviewArea">
          <div class="dp-preview-inner" id="dpPreviewInner" aria-live="polite"></div>
        </div>
        <!-- Code panel inside preview pane -->
        <div class="detail-code-pane">
          <div class="code-tabs" role="tablist">
            <button class="code-tab active" data-tab="html" onclick="switchCodeTab('html',this)" role="tab" aria-selected="true">HTML</button>
            <button class="code-tab" data-tab="css" onclick="switchCodeTab('css',this)" role="tab" aria-selected="false">CSS</button>
            <button class="code-tab" data-tab="tailwind" onclick="switchCodeTab('tailwind',this)" role="tab" aria-selected="false">Tailwind</button>
            <button class="code-tab" data-tab="react" onclick="switchCodeTab('react',this)" role="tab" aria-selected="false">React</button>
          </div>
          <div class="code-pane active" id="code-html" role="tabpanel"><div class="code-block" id="codeHtml"></div></div>
          <div class="code-pane" id="code-css" role="tabpanel"><div class="code-block" id="codeCss"></div></div>
          <div class="code-pane" id="code-tailwind" role="tabpanel"><div class="code-block" id="codeTailwind"></div></div>
          <div class="code-pane" id="code-react" role="tabpanel"><div class="code-block" id="codeReact"></div></div>
          <div class="code-actions">
            <span class="code-meta" id="codeMeta">HTML · 0 lines</span>
            <div class="code-btns">
              <button class="code-share" onclick="shareComp()" aria-label="Copy share link">⬀ Share</button>
              <button class="code-copy" id="codeCopyBtn" onclick="copyCode()" aria-label="Copy code to clipboard">Copy</button>
            </div>
          </div>
        </div>
      </div>
      <!-- Editor pane -->
      <div class="detail-editor-pane">
        <div class="ep-section" id="epProps">
          <div class="ep-section-hd" onclick="toggleSection('epProps')" aria-expanded="true">
            Properties <span class="ep-arrow">▾</span>
          </div>
          <div class="ep-section-body" id="epPropsBody"></div>
        </div>
        <div class="ep-section" id="epVariants">
          <div class="ep-section-hd" onclick="toggleSection('epVariants')" aria-expanded="true">
            Variants <span class="ep-arrow">▾</span>
          </div>
          <div class="ep-section-body" id="epVariantsBody"></div>
        </div>
        <div class="ep-section" style="border-bottom:none">
          <div class="ep-section-hd" onclick="toggleSection('epInfo')" aria-expanded="true">
            Info <span class="ep-arrow">▾</span>
          </div>
          <div class="ep-section-body" id="epInfoBody"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════════════
// COMPONENT REGISTRY
// Each entry: id, name, cat, tags, isNew?, variants[],
//   defaultProps, propSchema[], render(props)→html,
//   code: { html, css, tailwind, react }
// ═══════════════════════════════════════════════════════

const CATS = [
  { id:'all',      label:'All Components',    icon:'⊞' },
  { id:'navbar',   label:'Navbar',            icon:'≡' },
  { id:'hero',     label:'Hero Sections',     icon:'★' },
  { id:'cards',    label:'Cards',             icon:'🃏' },
  { id:'forms',    label:'Forms',             icon:'⌨' },
  { id:'modals',   label:'Modals & Overlays', icon:'🪟' },
  { id:'sidebars', label:'Sidebars',          icon:'◧' },
  { id:'dashboards',label:'Dashboards',       icon:'📊' },
  { id:'pricing',  label:'Pricing Tables',    icon:'💰' },
  { id:'loaders',  label:'Loaders',           icon:'⟳' },
  { id:'alerts',   label:'Toasts & Alerts',   icon:'🔔' },
  { id:'tabs',     label:'Tabs & Accordions', icon:'⊟' },
  { id:'timelines',label:'Timelines',         icon:'◎' },
  { id:'layouts',  label:'Page Layouts',      icon:'⊡', isNew:true },
];

const COMPS = [

// ─── NAVBAR ────────────────────────────────────────────
{ id:'nb1', name:'Dark Nav', cat:'navbar', tags:['nav','header','dark'], isNew:false,
  variants:['Default','Sticky','Transparent','Minimal'],
  defaultProps:{ bg:'#111110', text:'#f0ede8', accent:'#5558f0', logo:'UIForge', links:'Docs,Components,Blog', sticky:false, showCta:true },
  propSchema:[
    { key:'bg', label:'Background', type:'color' },
    { key:'text', label:'Text color', type:'color' },
    { key:'accent', label:'Accent', type:'color' },
    { key:'logo', label:'Logo text', type:'text' },
    { key:'links', label:'Nav links (comma)', type:'text' },
    { key:'sticky', label:'Sticky', type:'toggle' },
    { key:'showCta', label:'Show CTA button', type:'toggle' },
  ],
  render(p){
    const links = p.links.split(',').map(l=>`<a href="#" style="font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:${p.text};opacity:.7;transition:opacity .15s" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=.7">${l.trim()}</a>`).join('');
    return `<nav style="width:100%;max-width:860px;background:${p.bg};border-bottom:1px solid rgba(255,255,255,.08);padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:56px;gap:32px">
      <div style="font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:.06em;color:${p.text}">${p.logo.toUpperCase().replace(/(\w+)/, `$1`)}</div>
      <div style="display:flex;align-items:center;gap:24px">${links}</div>
      ${p.showCta ? `<button style="font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;padding:8px 18px;background:${p.accent};color:#fff;border:none;cursor:pointer">Get Started</button>` : ''}
    </nav>`;
  },
  code:{ html:`<nav class="navbar">
  <div class="logo">UIForge</div>
  <div class="nav-links">
    <a href="#">Docs</a>
    <a href="#">Components</a>
    <a href="#">Blog</a>
  </div>
  <button class="btn-primary">Get Started</button>
</nav>`,
    css:`.navbar{display:flex;align-items:center;justify-content:space-between;padding:0 24px;height:56px;background:#111110;border-bottom:1px solid rgba(255,255,255,.08);}
.logo{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:.06em;color:#f0ede8;}
.nav-links{display:flex;gap:24px;}
.nav-links a{font-family:monospace;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#f0ede8;opacity:.7;transition:opacity .15s;}
.nav-links a:hover{opacity:1;}
.btn-primary{padding:8px 18px;background:#5558f0;color:#fff;border:none;cursor:pointer;font-family:monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;}`,
    tailwind:`<nav class="flex items-center justify-between px-6 h-14 bg-neutral-900 border-b border-white/10">
  <span class="font-display text-2xl tracking-wider text-white">UIForge</span>
