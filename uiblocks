  { id:'c1', text:'Build a <strong>dark login form</strong> with social auth buttons and validation states.', hint:'Use the Login Form component and toggle "Show Social".' },
  { id:'c2', text:'Create a <strong>pricing table</strong> with 3 tiers — highlight the middle tier.', hint:'Set highlighted plan to "Pro" in the Pricing Table.' },
  { id:'c3', text:'Design a <strong>hero section</strong> using a gradient mesh background with 3 colors.', hint:'Try the Gradient Mesh Hero and adjust color1, color2, color3.' },
